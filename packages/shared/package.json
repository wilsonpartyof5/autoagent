{
  "name": "@autoagent/shared",
  "version": "1.0.0",
  "description": "Shared types and schemas for AutoAgent",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "./analytics.js": ["./src/analytics.d.ts"],
      "./analytics-validators.js": ["./src/analytics-validators.d.ts"],
      "./analytics-tracking-core.js": ["./src/analytics-tracking-core.d.ts"],
      "./uvs.js": ["./src/uvs.d.ts"],
      "./uvs-provider-schemas.js": ["./src/uvs-provider-schemas.d.ts"],
      "./marketcheck.js": ["./src/marketcheck.d.ts"],
      "./marketcheck-enrichment.js": ["./src/marketcheck-enrichment.d.ts"],
      "./index.js": ["./src/index.ts"]
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.22.4",
    "@types/node": "^20.10.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
