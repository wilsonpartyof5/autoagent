{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "./uvs": ["./uvs.ts"],
      "./uvs-provider-schemas": ["./uvs-provider-schemas.ts"],
      "./analytics": ["./analytics.ts"],
      "./analytics-validators": ["./analytics-validators.ts"],
      "./analytics-tracking-core": ["./analytics-tracking-core.ts"],
      "./types": ["./types.ts"],
      "./marketcheck": ["./marketcheck.ts"],
      "./marketcheck-enrichment": ["./marketcheck-enrichment.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
