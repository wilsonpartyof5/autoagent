<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LocalSecrets.plist.example
  
  Copy this file to LocalSecrets.plist (gitignored) and add your API key.
  Do NOT commit LocalSecrets.plist to source control.
-->
<plist version="1.0">
<dict>
	<key>INVENTORY_SEARCH_API_KEY</key>
	<string>your-api-key-here</string>
</dict>
</plist>
