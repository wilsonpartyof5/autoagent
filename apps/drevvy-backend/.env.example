NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared key the iOS app sends to /api/inventory/* and /api/query/*.
INVENTORY_SEARCH_API_KEY=

# MarketCheck hosted MCP. Shopper search calls this directly.
# Set MARKETCHECK_LIVE=1 to try a live comp lookup on the admin deal page.
# Without it, the admin console uses mock market insights.
MARKETCHECK_LIVE=
MARKETCHECK_API_KEY=
MARKETCHECK_API_SECRET=
MARKETCHECK_BASE_URL=
MARKETCHECK_MCP_URL=
MARKETCHECK_MCP_AUTH_TOKEN=
MARKETCHECK_MCP_AUTH_TYPE=
MARKETCHECK_PLAN_TIER=
MARKETCHECK_MONTHLY_LIMIT=

# Ask/Shop inventory parser. Vercel AI Gateway model openai/gpt-6-luna.
# On Vercel, VERCEL_OIDC_TOKEN is used when this key is unset.
AI_GATEWAY_API_KEY=

# Deal brain and admin insights.
OPENAI_API_KEY=

# Deal Brain LLM configuration
# OPENAI_MODEL: The main model for digest and reply decisions (default: gpt-4o)
OPENAI_MODEL=

# Comma-separated Telnyx sending domains for shopper aliases.
# When set, this overrides identity_settings.alias_domains.
# Default: offers.drevvy.com,deals.drevvy.com,quotes.drevvy.com,buyers.drevvy.com
# Each dealer keeps the domain stored on its first identity.
ALIAS_DOMAINS=

# Telnyx integration for calls, SMS, and email webhooks
# TELNYX_API_KEY: API key from the Telnyx portal
# TELNYX_PUBLIC_KEY: Base64-encoded Ed25519 public key for webhook signature verification
# TELNYX_FROM_NUMBER: E.164 number the SMS send gateway sends from
# TELNYX_MESSAGING_PROFILE_ID: optional Telnyx messaging profile
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=

# ElevenLabs integration for AI voice calls
# ELEVENLABS_API_KEY: API key from ElevenLabs dashboard
# ELEVENLABS_WEBHOOK_SECRET: Webhook signing secret for HMAC verification
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=

# ClickHouse (Dealer Analytics) read-only access for metrics queries
# These are optional; when unset, metrics tools will return empty data
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Shared secret for all cron routes (/api/cron/*)
# Required for: brain-health, brain-digest, vendor-status, deal-lifecycle, deal-events
CRON_SECRET=

# Comma-separated Supabase auth emails allowed into /admin.
# Leave empty to hide the operator console. Do not commit real addresses.
ADMIN_EMAILS=

# Optional. Set to 1 only on a local dev server to render /admin without a session.
# Ignored when NODE_ENV=production, including Vercel.
ADMIN_PREVIEW=

# Optional. Set to 1 only on a local dev server to render /dealer without a
# rooftop membership. Also honored when ADMIN_PREVIEW=1. Ignored in production.
DEALER_PREVIEW=

# RevenueCat secret API key. Credit purchases are refused with 503 until this is set.
# REVENUECAT_WEBHOOK_SECRET is the Authorization header value configured on the webhook.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# Leave unset until 20261012183301_deal_lifecycle.sql is applied. supabase reads the
# lifecycle table; any other value keeps an in-memory ledger so deal queries
# stay on the current shopper_deals columns.
DEAL_LIFECYCLE_STORE=

# Legacy cron secret (used by /api/cron/deal-lifecycle, /api/cron/deal-events,
# and /api/cron/push-events). Prefer CRON_SECRET for new routes. When both are
# unset, cron routes respond 404.
DREVVY_CRON_SECRET=

# FCM HTTP v1 for shopper push (APNs through FCM). When any value is unset,
# sendPush is a no-op and does not call Google.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Comma-separated Google OAuth client IDs for iOS, Android, and web.
# When unset, POST /api/consumer/auth/google responds 503.
GOOGLE_OAUTH_CLIENT_IDS=

# App Store and Google Play URLs for the Drevvy app.
# When set, the /get route redirects mobile users to the appropriate store.
# When unset, users see a "notify me" waitlist option.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
