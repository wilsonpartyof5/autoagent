NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared key the iOS app sends to /api/inventory/* and /api/query/*.
INVENTORY_SEARCH_API_KEY=

# MarketCheck hosted MCP. Shopper search calls this directly.
# Set MARKETCHECK_LIVE=1 to try a live comp lookup on the admin deal page.
# Without it, the admin console uses mock market insights.
MARKETCHECK_LIVE=
MARKETCHECK_API_KEY=
MARKETCHECK_API_SECRET=
MARKETCHECK_BASE_URL=
MARKETCHECK_MCP_URL=
MARKETCHECK_MCP_AUTH_TOKEN=
MARKETCHECK_MCP_AUTH_TYPE=
MARKETCHECK_PLAN_TIER=
MARKETCHECK_MONTHLY_LIMIT=

# Query parser for Ask/Shop. Not the ChatGPT app.
OPENAI_API_KEY=

# Comma-separated Supabase auth emails allowed into /admin.
# Leave empty to hide the operator console. Do not commit real addresses.
ADMIN_EMAILS=

# Optional. Set to 1 only on a local dev server to render /admin without a session.
# Ignored when NODE_ENV=production, including Vercel.
ADMIN_PREVIEW=
