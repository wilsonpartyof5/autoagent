NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Comma-separated Supabase auth emails allowed into /admin.
# Leave empty to hide the shopper admin console. Do not commit real addresses.
ADMIN_EMAILS=

# Optional. Set to 1 only on a local dev server to render /admin without a session.
# Ignored when NODE_ENV=production, including Vercel.
ADMIN_PREVIEW=

# Optional. Set to 1 to try a live MarketCheck MCP comp lookup on the deal page.
# Without it, the admin console uses mock market insights.
MARKETCHECK_LIVE=
MARKETCHECK_API_KEY=
