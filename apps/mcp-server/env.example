# Server Configuration
PORT=8787

# ============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# ============================================================================
# These variables MUST be set or the server will fail to start with a clear error.

# Widget Configuration (REQUIRED)
# The publicly reachable MCP host URL (no trailing slash)
# Production: https://autoagentmcp-server-production.up.railway.app
# Local dev: http://localhost:8787 (if using ngrok, use the ngrok URL)
WIDGET_HOST=https://autoagentmcp-server-production.up.railway.app

# MarketCheck API (REQUIRED)
# Get your API key from https://www.marketcheck.com/
MARKETCHECK_API_KEY=your_marketcheck_api_key_here
# Optional: Override the base URL (defaults to https://marketcheck-prod.apigee.net)
MARKETCHECK_BASE_URL=https://marketcheck-prod.apigee.net

# Lead Encryption Key (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be exactly 32 bytes when base64 decoded
LEAD_ENC_KEY=your_32_byte_base64_encryption_key_here

# Dashboard Ingest Configuration (REQUIRED)
# URL where leads should be forwarded
DASHBOARD_INGEST_URL=https://your-dashboard-domain.com/api/ingest/lead
# Bearer token for authenticating with the dashboard ingest endpoint
DASHBOARD_INGEST_TOKEN=your_secure_dashboard_token_here

# ============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# ============================================================================

# OpenAI App Configuration
OPENAI_APP_NAME=AutoAgent

# AutoAgent Diagnostics (enable detailed logging)
# Set to '1' or 'true' to enable
AA_DIAG=0

# Supabase Configuration (optional - only needed for delivery logs)
# If not set, delivery logs will not be stored in Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Or use anon key (limited functionality)
SUPABASE_ANON_KEY=your_anon_key

# Commit SHA (optional - auto-detected from Railway/CI/CD)
# Used in health check endpoint
# RAILWAY_GIT_COMMIT_SHA=abc123
# GIT_COMMIT_SHA=abc123
# COMMIT_SHA=abc123
