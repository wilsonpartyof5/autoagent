{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.drevvy.com/schema/unified-vehicle/v1",
  "title": "Unified Vehicle Schema (UVS)",
  "description": "Provider-agnostic schema for normalizing dealership vehicle inventory across MarketCheck, Homenet, vAuto, OEM feeds, Dealer.com, Dealer Inspire, CDK, Reynolds, S3, CSV, and direct dealer APIs.",
  "type": "object",
  "required": ["id", "baseIdentity", "condition", "pricing", "location", "operational"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Internal unique vehicle ID. Required."
    },
    "baseIdentity": {
      "type": "object",
      "description": "Core identification fields.",
      "required": ["year", "make", "model"],
      "properties": {
        "vin": {
          "type": "string",
          "pattern": "^[A-HJ-NPR-Z0-9]{11,17}$",
          "description": "VIN (optional but strongly recommended)."
        },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "make": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "trim": { "type": "string" },
        "stockNumber": { "type": "string" },
        "listingId": { "type": "string" },
        "vehicleType": {
          "type": "string",
          "enum": ["car", "truck", "suv", "van", "motorcycle", "rv", "trailer", "other"]
        }
      }
    },
    "condition": {
      "type": "string",
      "enum": ["new", "used", "certified"],
      "description": "Required condition field used by MCP workflows."
    },
    "coreSpecs": {
      "type": "object",
      "description": "Essential vehicle specifications.",
      "properties": {
        "bodyType": { "type": "string" },
        "fuelType": {
          "type": "string",
          "enum": ["gasoline", "diesel", "electric", "hybrid", "plug-in hybrid", "flex fuel", "natural gas", "hydrogen", "other"]
        },
        "engine": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "displacement": { "type": "number", "minimum": 0 },
            "cylinders": { "type": "integer", "minimum": 0, "maximum": 16 },
            "horsepower": { "type": "integer", "minimum": 0 }
          }
        },
        "transmission": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "type": {
              "type": "string",
              "enum": ["automatic", "manual", "cvt", "dual clutch", "automated manual"]
            }
          }
        },
        "drivetrain": {
          "type": "string",
          "enum": ["fwd", "rwd", "awd", "4wd", "part-time 4wd"]
        },
        "odometer": {
          "type": "object",
          "description": "Unified odometer block.",
          "properties": {
            "value": { "type": "number", "minimum": 0 },
            "unit": { "type": "string", "enum": ["mi", "km"] }
          }
        }
      }
    },
    "pricing": {
      "type": "object",
      "description": "Pricing block. Price is required.",
      "required": ["price"],
      "properties": {
        "price": { "type": "number", "minimum": 0 },
        "msrp": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "default": "USD" }
      }
    },
    "featuresPackages": {
      "type": "object",
      "description": "Structured features and options.",
      "properties": {
        "features": {
          "type": "array",
          "description": "Structured feature list with categories.",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "code": { "type": "string" },
              "category": {
                "type": "string",
                "enum": [
                  "safety",
                  "interior",
                  "exterior",
                  "convenience",
                  "technology",
                  "entertainment",
                  "performance",
                  "other"
                ]
              },
              "description": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "code": { "type": "string" },
              "price": { "type": "number", "minimum": 0 },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "primaryPhotoUrl": { "type": "string", "format": "uri" },
        "photoUrls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        }
      }
    },
    "location": {
      "type": "object",
      "required": ["dealer"],
      "properties": {
        "dealer": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "dealerId": { "type": "string" },
            "name": { "type": "string", "minLength": 1 },
            "city": { "type": "string" },
            "state": { "type": "string" }
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["available", "pending", "sold", "in_transit", "unavailable"],
          "default": "available"
        }
      }
    },
    "marketData": {
      "type": "object",
      "description": "Simplified competitive data.",
      "properties": {
        "averageDaysOnMarket": { "type": "number", "minimum": 0 }
      }
    },
    "operational": {
      "type": "object",
      "required": ["lastSyncedAt"],
      "properties": {
        "dataSource": { "type": "string" },
        "lastSyncedAt": { "type": "string", "format": "date-time" },
        "syncStatus": {
          "type": "string",
          "enum": ["pending", "success", "failed"],
          "default": "success"
        }
      }
    },
    "dealerDefined": {
      "type": "object",
      "description": "Dealer custom metadata.",
      "additionalProperties": true
    },
    "enrichment": {
      "type": "object",
      "description": "AI or third-party enhancements.",
      "additionalProperties": true
    }
  }
}

