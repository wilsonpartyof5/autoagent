# OpenAI-compatible chat API. Point this at xAI to use a Grok model:
#   AI_BASE_URL=https://api.x.ai/v1
#   AI_MODEL=grok-4
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Service role only. The worker writes dealer_directory and widget_chat_attempts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dry run is the default. Live sends require the exact string false AND an allowlist.
DRY_RUN=true
# Comma-separated dealer origins. Hostname match. Empty means send nowhere.
WIDGET_CHAT_ALLOWLIST=

# Drevvy's own text number and email. Lead forms and pre-chat gates use these.
DREVVY_TEXT_NUMBER=
DREVVY_EMAIL=
# First name only. Lead forms, pre-chat gates, and the bot disclosure use this.
SHOPPER_FIRST_NAME=
# Last-name box on a dealer lead form. Default: via Drevvy
LEAD_LAST_NAME=via Drevvy
# Required only when a lead form has a ZIP field. 12345 or 12345-6789.
DREVVY_ZIP=

# Optional.
RESEARCH_FETCH_TIMEOUT_MS=15000
# Hard cap is 6 even if this is higher.
WIDGET_CHAT_MAX_TURNS=6
# Extra wait after network idle before looking for a chat launcher. Default 3000.
WIDGET_SCAN_SETTLE_MS=3000
# How many dealer sites `scan` opens at once. Default 3. `--concurrency` overrides this.
WIDGET_SCAN_CONCURRENCY=3
# Per-site cap for `scan`, in milliseconds. Default 25000.
WIDGET_SCAN_TIMEOUT_MS=25000

# Seed only. Lists dealer names and websites near launch-area ZIPs.
# The key is not stored. Raw MarketCheck listing payloads are not stored.
MARKETCHECK_API_KEY=
MARKETCHECK_BASE_URL=https://api.marketcheck.com
# Gap between MarketCheck pages and dealer-site fetches, in milliseconds.
SEED_MIN_INTERVAL_MS=1000
