# Drevvy MCP Server - Production Environment Variables
# Copy this file to .env.production and fill in the actual values
# DO NOT commit .env.production to version control
#
# IMPORTANT: All variables marked (REQUIRED) must be set or the server will fail to start.

# ============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# ============================================================================

# Server Configuration
PORT=8787

# Widget Configuration (REQUIRED)
# The publicly reachable MCP host URL (no trailing slash)
WIDGET_HOST=https://autoagentmcp-server-production.up.railway.app

# MarketCheck API Configuration (REQUIRED)
MARKETCHECK_API_KEY=your_marketcheck_api_key_here
MARKETCHECK_BASE_URL=https://marketcheck-prod.apigee.net

# Lead Security & Forwarding (REQUIRED)
# Generate encryption key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LEAD_ENC_KEY=your_32_byte_base64_encryption_key_here
DASHBOARD_INGEST_URL=https://your-dashboard-domain.com/api/ingest/lead
DASHBOARD_INGEST_TOKEN=your_secure_dashboard_token_here

# ============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# ============================================================================

# Drevvy Diagnostics (enable detailed logging)
AA_DIAG=1

# OpenAI App Configuration
OPENAI_APP_NAME=Drevvy

# Supabase Configuration (optional - only needed for delivery logs)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_ANON_KEY=your_anon_key

# Database Configuration (for future Postgres migration)
# DATABASE_URL=postgresql://user:password@host:port/database
# DB_HOST=your-postgres-host
# DB_PORT=5432
# DB_NAME=autoagent
# DB_USER=your-db-user
# DB_PASSWORD=your-db-password

# Redis Configuration (for production rate limiting)
# REDIS_URL=redis://your-redis-host:6379
# REDIS_PASSWORD=your-redis-password

# Monitoring & Logging
# LOG_LEVEL=info
# SENTRY_DSN=your-sentry-dsn-here
