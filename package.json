{
  "name": "autoagent",
  "version": "1.0.0",
  "description": "AI-powered car discovery and lead-gen app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "update-docs": "node scripts/update-markdown-summary.js",
    "watch-docs": "node scripts/update-markdown-summary.js --watch"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.77.0",
    "@types/node": "^20.10.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.55.0",
    "libsodium-wrappers": "^0.7.11",
    "nanoid": "^5.0.4",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
